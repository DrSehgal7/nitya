{
  "name": "nitya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:local": "PLAYWRIGHT_SYSTEM_CHROME=1 playwright test",
    "review:visual": "CAPTURE_SCREENSHOT=1 PLAYWRIGHT_SYSTEM_CHROME=1 playwright test --grep 'shows the focused impact|about tells Hritik|theme toggle'",
    "sync:strava": "node --import tsx scripts/sync-strava.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
