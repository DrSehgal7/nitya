# Used only by the build-time Strava sync. Never expose these as PUBLIC_* values.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Canonical production URL used for metadata, redirects, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Owner-only Google authentication. Keep every value server-side.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
OWNER_EMAIL=sarojhritik@gmail.com

# Vercel creates BLOB_STORE_ID and short-lived OIDC credentials when the private
# nitya-content Blob store is connected. Do not commit a read/write token.
